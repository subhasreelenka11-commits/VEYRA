generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  
  profile          UserProfile?
  nutritionPlan    NutritionPlan?
  smartRecipes     SmartRecipe[]
  skinScans        SkinScan[]
  groomingRoutine  GroomingRoutine?
  routineProgresses RoutineProgress[]
}

model UserProfile {
  id                String             @id @default(uuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  firstName         String?
  lastName          String?
  age               Int?
  height            Float?
  weight            Float?
  gender            String?
  
  activityLevel     ActivityLevel?
  goal              Goal?
  dietaryPreference DietaryPreference?
  allergies         String[]
  dislikes          String[]
  
  budget            Float?
  cookingTime       Int?
  
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum Goal {
  WEIGHT_LOSS
  WEIGHT_GAIN
  MAINTENANCE
  GENERAL_WELLNESS
}

enum DietaryPreference {
  VEGETARIAN
  NON_VEGETARIAN
  VEGAN
  EGGETARIAN
  OTHER
}

model NutritionPlan {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  bmi            Float
  bmr            Float
  tdee           Float
  targetCalories Float
  proteinGrams   Float
  carbsGrams     Float
  fatGrams       Float
  
  planData       Json     // Stores the structured JSON from the AI
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SmartRecipe {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  recipeData     Json     // Stores the structured JSON from the AI
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SkinScan {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  overallScore Int
  summary      String?
  metrics      Json
  actives      Json
  
  recommendations SkinRecommendation[]

  createdAt    DateTime @default(now())
}

model GroomingRoutine {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  routineData Json     // Stores morning, evening, and weekly steps generated by AI
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RoutineProgress {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  date           String   // Stored as YYYY-MM-DD
  completedSteps String[] // Array of step IDs (e.g., ["m1", "e2"])
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, date]) // Only one progress record per user per day
}

model Product {
  id            String   @id @default(uuid())
  name          String
  brand         String
  category      String   // e.g., FACE_WASH, MOISTURIZER, SUNSCREEN
  subCategory   String?
  description   String?
  ingredients   String[]
  skinTypes     String[] // e.g., COMBINATION, DRY, OILY
  concerns      String[] // e.g., ACNE, UNEVEN_TONE
  suitableFor   String[]
  avoidFor      String[]
  price         Float?
  currency      String   @default("INR")
  productUrl    String?
  imageUrl      String?
  isActive      Boolean  @default(true)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SkinRecommendation {
  id                 String   @id @default(uuid())
  skinAnalysisId     String
  skinAnalysis       SkinScan @relation(fields: [skinAnalysisId], references: [id], onDelete: Cascade)
  
  category           String   // SKINCARE, LIFESTYLE, DIET, HOME_CARE
  recommendationType String   // CLEANSER, MOISTURIZER, SLEEP, HYDRATION
  title              String
  description        String?
  reason             String?
  priority           String   @default("NORMAL")
  instructions       String?
  
  // JSON object storing the AI's required product traits
  requirements       Json?    
  
  createdAt          DateTime @default(now())
}
